{
  "name": "classroom-simcity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/scripts/lab/lab.test.js src/scripts/auth/hsuId.test.js src/scripts/camera/gestures.test.js src/scripts/tutorial/tourSteps.test.js src/scripts/templates/generateCity.test.js src/scripts/ui/activeControl.test.js src/scripts/disaster/disasterImpact.test.js src/scripts/disaster/apiAndDisaster.test.js",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "deploy": "bash scripts/deploy-to-cloudflare.sh",
    "db:migrate": "wrangler d1 execute classroom-simcity --file=worker/schema.sql",
    "db:migrate:local": "wrangler d1 execute classroom-simcity --local --file=worker/schema.sql",
    "seed-admin": "node scripts/seed-admin.js"
  },
  "devDependencies": {
    "vite": "^4.4.9",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-joyride": "^3.2.0",
    "three": "^0.155.0"
  }
}
